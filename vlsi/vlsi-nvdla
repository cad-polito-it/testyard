def add_options(x: HammerTool) -> bool:
    if x.get_setting("vlsi.core.technology") == "hammer.technology.asap7":
        # Needed by design compiler because asap7 has no three state cells
        if x.get_setting("vlsi.core.synthesis_tool") == "hammer.synthesis.dc":
            x.append("set_app_var compile_assume_fully_decoded_three_state_busses true")
    if x.get_setting("vlsi.core.synthesis_tool") == "hammer.synthesis.dc":
        x.append("set_app_var compile_assume_fully_decoded_three_state_busses true")
        x.append("set_app_var test_validate_test_model_connectivity true")
        x.append("set_app_var compile_seqmap_identify_shift_registers_with_synchronous_logic true")
        x.append("set_app_var compile_seqmap_identify_shift_registers true")
        x.append("set_app_var verilogout_no_tri true")
        x.append("set_app_var test_setup_additional_clock_pulse true")
        x.append("set_app_var hdlin_elaborate_black_box \"nv_ram_*\"")
        x.append("set_app_var compile_seqmap_propagate_high_effort false")
        x.append("set_app_var compile_restructure_sync_set_reset true")
        x.append("set_app_var compile_seqmap_propagate_constants false")
    return True 

def connect_clk_en_reg(x: HammerTool) -> bool:
    if x.get_setting("vlsi.core.technology") == "hammer.technology.asap7":
        x.append("set test_fix_bus true")
        if x.get_setting("vlsi.core.synthesis_tool") == "hammer.synthesis.dc":
            x.append("disconnect_net [all_connected clock_en_reg/RESET] clock_en_reg/RESET")
            x.append("connect_pin -from [get_nets n_debug_reset_syncd_debug_reset_sync_io_q ] -to clock_en_reg/RESET ")
    return True
    
def connect_black_box_signals(x: HammerTool) -> bool:
    if x.get_setting("vlsi.core.synthesis_tool") == "hammer.synthesis.dc": 
    # Connect top level black box's signals (unconnected) to scan signals                     
        x.append("set pin [get_pins system/domain/nvdla/u_nvdla/nvdla_top/test_mode]")                                                                        
        x.append("disconnect_net [all_connected $pin] $pin")                                                                                                  
        x.append("connect_pin -from [get_port test_mode]  -to $pin  -port_name test_mode_i_core")        

        # direct reset connection 
        x.append("set pin [get_pins system/domain/nvdla/u_nvdla/nvdla_top/direct_reset_]")    
        x.append("disconnect_net [all_connected $pin] $pin")                                                                                                  
        x.append("connect_pin -from [get_port reset_io]  -to $pin  -port_name reset_io_i_top")        
        x.append("set_dft_drc_rules -ignore {TEST-504}")
        x.append("set_dft_drc_rules -ignore {TEST-505}")
        # There is an unexpected inversion on the reset line between the top-level and the block-level and dft insertion get lost.
        # Create inverter cell with highest strength
        gate_cells = x.technology.get_special_cell_by_type(CellType.CTSInverter)
        if len(gate_cells) > 0:
            selected_cell = gate_cells[-1].name[-1]
            # Inverters have single i/os
            input = gate_cells[-1].input_ports[-1]
            output = gate_cells[-1].output_ports[-1]
            # The name from {x.technology.config.name} does not always reflect the name in the liberty file, the interest libs is always in the first position
            if x.get_setting("vlsi.core.technology") != "hammer.technology.asap7":
                x.append("set libs_name [get_object_name [get_libs]]")
                x.append("set lib_name [lindex $libs_name 0]")
                x.append(f"set lib_cell $lib_name/{selected_cell}")
            else:
                # Specific cell from a specific library
                x.append("set lib_cell asap7sc7p5t_INVBUF_RVT_TT_nldm_201020/INVx5_ASAP7_75t_R")
            x.append("create_cell system/domain/nvdla/inv_rst $lib_cell")
            x.append("disconnect_net [all_connected system/domain/nvdla/u_nvdla/rstn] system/domain/nvdla/u_nvdla/rstn")
            x.append(f"connect_pin -from [get_port reset_io]  -to system/domain/nvdla/inv_rst/{input}  -port_name reset_io_i")    
            x.append(f"connect_pin -from system/domain/nvdla/inv_rst/{output} -to system/domain/nvdla/u_nvdla/rstn  -port_name reset_inverted_i")

            x.append("create_cell system/domain/nvdla/inv_rst2  $lib_cell")
            x.append("disconnect_net [all_connected system/domain/nvdla/u_nvdla/csb_rstn] system/domain/nvdla/u_nvdla/csb_rstn")
            x.append(f"connect_pin -from [get_port reset_io]  -to system/domain/nvdla/inv_rst2/{input}  -port_name reset_io_i")    
            x.append(f"connect_pin -from system/domain/nvdla/inv_rst2/{output} -to system/domain/nvdla/u_nvdla/csb_rstn  -port_name reset_inverted_i_2")        
        else:
            x.logger.error("Current technology does not have any definitions for inverter cells")                                      
    return True

def insert_internal_memory_collar(x: HammerTool) -> bool:
    if x.get_setting("vlsi.core.synthesis_tool") == "hammer.synthesis.dc":
        if x.get_setting("synthesis.insert_dft.memory_wrapper"):
            x.append("set srams_tp [get_references -hierarchical \"*nv_ram_rws*\"]")
            x.append("foreach_in_collection s $srams_tp {")
            x.append(x.insert_test_points(["$s"]))
            x.append("}")

        x.append("set_dft_clock_gating_pin {system/domain/nvdla/u_nvdla/nvdla_top/tmc2slcg_disable_clock_gating} -pin_name tmc2slcg_disable_clock_gating -control_signal TestMode")
        x.append("identify_clock_gating")
        x.append("set_testability_configuration -target random_resistant")
        x.append("set_testability_configuration -targetx_blocking")
        x.append("set_testability_configuration -target multicycle_paths")
        x.append("set_testability_configuration -target atpg_conflict")
    return True

def add_black_boxes(x: HammerTool) -> bool:
    if x.get_setting("vlsi.core.synthesis_tool") == "hammer.synthesis.dc":
        # This is equivalent of setting the nv_ram_*logical* as black boxes with x.append("set_app_var hdlin_elaborate_black_box \"nv_ram_*logical*\"")
        # The only difference is an additional step executed at the end of synthesis to
        # remove empty modules (see vlsi-cva6) to simplify simulation.
        rams = ["nv_ram_rws_256x3",
                "nv_ram_rwsp_8x65",
                "nv_ram_rwsthp_80x9",
                "nv_ram_rwsthp_80x17",
                "nv_ram_rwsthp_60x21",
                "nv_ram_rwsthp_20x4",
                "nv_ram_rwsp_128x6",
                "nv_ram_rwsp_128x11",
                "nv_ram_rwsp_16x14",
                "nv_ram_rwsp_16x16",
                "nv_ram_rwsp_16x65",]
        for ram in rams:
            x.append(f"remove_design [get_designs -hierarchical -filter \"name =~ *{ram}*\"]")
            x.append(f"foreach f [glob -nocomplain ./WORK/*{ram}* ] {{")
            x.append("    file delete -force $f")
            x.append("    link")
            x.append("}")
            x.append(f"foreach_in_collection ram [get_references -hierarchical -filter \"name =~ *{ram}*\"] {{")
            x.append("  set_attribute $ram is_memory_cell true")
            x.append("  set_attribute $ram is_logical_black_box true" )
            x.append("  set_attribute $ram is_physical_black_box true" )
            x.append("  set_dont_touch $ram")
            x.append("}")
        
    return True 

def insert_nofaults_modules(x: HammerTool) -> bool:
    # Do not add faults around the following modules
    x.additional_modules = ["nv_ram_.*"]
    return True

