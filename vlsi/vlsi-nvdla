MODULE_PATTERN = re.compile(r"\bmodule\s+([A-Za-z_]\w*)\b")
ENDMODULE_PATTERN = re.compile(r"\bendmodule\b")
# "<base>_<N>" -> instantiate <base> with parameter N
SUFFIX_PATTERN = re.compile(r"^(?P<base>.+)_(?P<param>\d+)$")
COMMENT_PATTERN = re.compile(r"//[^\n]*|/\*.*?\*/", re.DOTALL)

INSTANCE_NAME = "ram_inst"


def _iter_blocks(lines: Iterable[str]) -> Iterator[tuple[str | None, list[str]]]:
    """Yield ``(module_name, lines)`` blocks.

    Lines outside any module are yielded one by one with ``module_name=None``.
    A module is yielded as one block from its ``module`` line up to and
    including its ``endmodule`` line.
    """
    name: str | None = None
    block: list[str] = []

    for line in lines:
        if name is None:
            match = MODULE_PATTERN.search(line)
            if not match:
                yield None, [line]
                continue
            name, block = match.group(1), [line]
        else:
            block.append(line)

        if ENDMODULE_PATTERN.search(line):
            yield name, block
            name, block = None, []

    if name is not None:  # unterminated module at EOF
        yield name, block


def _balanced_parens(text: str, start: int) -> tuple[str, int]:
    """Return (inner text, index after closing paren) for text[start] == '('."""
    depth = 0
    for i in range(start, len(text)):
        if text[i] == "(":
            depth += 1
        elif text[i] == ")":
            depth -= 1
            if depth == 0:
                return text[start + 1 : i], i + 1
    raise ValueError("Unbalanced parentheses in module header")


def _extract_port_names(module_text: str, module_name: str) -> list[str]:
    """Extract port names from the module header (ANSI and non-ANSI style)."""
    text = COMMENT_PATTERN.sub(" ", module_text)
    pos = MODULE_PATTERN.search(text).end()

    def skip_ws(p: int) -> int:
        while p < len(text) and text[p].isspace():
            p += 1
        return p

    pos = skip_ws(pos)
    if text.startswith("#", pos):  # skip parameter list: #( ... )
        pos = skip_ws(pos + 1)
        _, pos = _balanced_parens(text, pos)
        pos = skip_ws(pos)

    if not text.startswith("(", pos):  # no port list: "module foo;"
        return []

    inner, _ = _balanced_parens(text, pos)
    inner = re.sub(r"\[[^\]]*\]", " ", inner)  # drop [..] ranges

    ports = []
    for item in inner.split(","):
        words = re.findall(r"[A-Za-z_]\w*", item)
        if words:
            ports.append(words[-1])  # last identifier is the port name
    return ports


def _add_instance(block: list[str], base: str, param: str) -> list[str]:
    """Insert an instance of ``base`` right before ``endmodule``."""
    module_name = MODULE_PATTERN.search(block[0]).group(1)
    ports = _extract_port_names("".join(block), module_name)
    connections = ", ".join(f".{p}({p})" for p in ports)
    instance = f"{base} #({param}) {INSTANCE_NAME} ( {connections} );"

    last = block[-1]
    match = ENDMODULE_PATTERN.search(last)
    if not match:  # unterminated module: leave untouched
        return block

    prefix = last[: match.start()]
    if prefix.strip():  # declaration and endmodule share a line
        prefix += "\n"

    block[-1] = f"{prefix}{instance}\n{last[match.start():]}"
    return block


def remove_modules_streamed(
    file_path: str | Path,
    module_names: list[str] | set[str],
) -> None:
    """Remove modules from a Verilog/SystemVerilog file and wrap their variants.

    - A module whose name exactly matches an entry in ``module_names`` is removed.
    - A module named ``<name>_<N>`` where ``<name>`` is in ``module_names`` is
      kept, and an instance ``<name> #(<N>) ram_inst ( .port, ... );`` is
      inserted before its ``endmodule``.

    The file is processed one module at a time and written to a temporary file
    next to the input, which atomically replaces the original on success.

    Raises
    ------
    FileNotFoundError
        If ``file_path`` does not exist.
    ValueError
        If ``module_names`` is empty.
    """
    input_path = Path(file_path)

    if not input_path.is_file():
        raise FileNotFoundError(f"Input file does not exist: {input_path}")
    if not module_names:
        raise ValueError("module_names must contain at least one module name")

    module_names = set(module_names)
    temp_path = input_path.with_name(input_path.name + ".tmp")

    try:
        with (
            input_path.open("r", encoding="utf-8") as infile,
            temp_path.open("w", encoding="utf-8") as outfile,
        ):
            for name, block in _iter_blocks(infile):
                if name is not None:
                    if name in module_names:
                        continue  # exact match: drop the module

                    suffix = SUFFIX_PATTERN.match(name)
                    if suffix and suffix["base"] in module_names:
                        block = _add_instance(block, suffix["base"], suffix["param"])

                outfile.writelines(block)

        temp_path.replace(input_path)

    except Exception:
        temp_path.unlink(missing_ok=True)
        raise


class ExampleDriver(CLIDriver):
    def get_extra_synthesis_hooks(self) -> List[HammerToolHookAction]:
        extra_hooks = [
            HammerTool.make_post_insertion_hook("init_environment", add_options),
            HammerTool.make_post_insertion_hook("elaborate_design", add_black_boxes),
            HammerTool.make_pre_insertion_hook("configure_dft", connect_clk_en_reg),
            HammerTool.make_post_insertion_hook("configure_dft", insert_internal_memory_collar),
            HammerTool.make_post_insertion_hook("configure_dft", connect_black_box_signals)
        ]
        return extra_hooks
    # Customized synthesis action with a combined post run step for removing empty modules and facilitates lsim and fsim
    def custom_synthesis_post_run(self, driver: HammerDriver) -> None:
        """Custom post-synthesis task (e.g., netlist modification)."""
        try:
            top_module = driver.syn_tool.top_module
            mapped_v = os.path.join(driver.obj_dir, "syn-rundir", "results" , f"{top_module}.mapped.v")

            if os.path.exists(mapped_v):
                driver.syn_tool.logger.info(f"[Post-Synthesis] ,tripping empty SRAM modules from {mapped_v}")
                remove_modules_streamed(mapped_v, [ 
                        "nv_ram_rwsp_16x65",
                        "nv_ram_rwsp_16x16",
                        "nv_ram_rwsp_16x14",
                        "nv_ram_rwsp_128x11",
                        "nv_ram_rwsthp_20x4",
                        "nv_ram_rwsthp_60x21",
                        "nv_ram_rwsthp_80x17",
                        "nv_ram_rwsthp_80x9",
                        "nv_ram_rwsp_128x6",
                        "nv_ram_rwsp_8x65",
                        "nv_ram_rws_256x3",
                        "nv_ram_rws_128x18",
                        "nv_ram_rwst_256x8",
                        "nv_ram_rws_16x256",
                        "nv_ram_rws_16x272",
                        "nv_ram_rws_16x64",
                        "nv_ram_rws_256x64",
                ])
            else:
                driver.syn_tool.logger.warning(f"[Post-Synthesis] Netlist not found at: {mapped_v}")
        except Exception as e:
            driver.syn_tool.logger.error(f"[Post-Synthesis] Exception during netlist processing: {e}")

    # Override internal declaration in CLIDriver 
    def create_synthesis_action(
        self,
        custom_hooks: List[HammerToolHookAction],
        pre_action_func: Optional[Callable[[HammerDriver], None]] = None,
        post_load_func: Optional[Callable[[HammerDriver], None]] = None,
        post_run_func: Optional[Callable[[HammerDriver], None]] = None
    ) -> CLIActionConfigType:

        # Combine passed post_run_func argument with the custom post-run logic
        def combined_post_run(driver: HammerDriver) -> None:
            # 1. Execute passed post_run_func argument (if supplied)
            if post_run_func is not None:
                post_run_func(driver)

            # 2. Execute custom post-run logic
            self.custom_synthesis_post_run(driver)

        # Delegate to super with the combined callback
        return super().create_synthesis_action(
            custom_hooks=custom_hooks,
            pre_action_func=pre_action_func,
            post_load_func=post_load_func,
            post_run_func=combined_post_run
        )
    
    def get_extra_atpg_hooks(self) -> List[HammerToolHookAction]:
        extra_hooks = [
            HammerTool.make_pre_insertion_hook("run_drc", add_constraints),
            HammerTool.make_pre_insertion_hook("run_atpg", insert_nofaults_modules)
        ]
        return extra_hooks

if __name__ == '__main__':
    ExampleDriver().main()
